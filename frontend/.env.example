# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (@futsal/frontend - Vite React Port 5173)
# Copy file ini menjadi `frontend/.env.local`
# ============================================================================

# Kosongkan jika menggunakan Vite proxy ke http://localhost:3000, atau isi URL backend produksi
VITE_API_BASE_URL=

# Set `false` untuk mematikan local mock fallback dan menggunakan 100% Backend Supabase Live
VITE_USE_MOCK=false

# --- SUPABASE CLIENT (Untuk OAuth Google & Session JWT) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- MIDTRANS SNAP CLIENT ---
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# --- PUSHER REAL-TIME CLIENT ---
VITE_PUSHER_KEY=xxxxxxxxxxxxxxxxxxxx
VITE_PUSHER_CLUSTER=ap1
