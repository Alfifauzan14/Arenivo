# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (@futsal/backend - Next.js Port 3000)
# Copy file ini menjadi `backend/.env.local` (DILARANG memakai prefix NEXT_PUBLIC_)
# ============================================================================

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- 1. SUPABASE (Database PostgreSQL, Auth JWT, Storage Buckets) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- 2. MIDTRANS (Payment Gateway Snap & Refund API) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# --- 3. PUSHER CHANNELS (Real-Time WebSocket Slot Grid & Notifikasi) ---
PUSHER_APP_ID=123456
PUSHER_KEY=xxxxxxxxxxxxxxxxxxxx
PUSHER_SECRET=xxxxxxxxxxxxxxxxxxxx
PUSHER_CLUSTER=ap1

# --- 4. BREVO EMAIL SERVICE (SMTP / Transactional API) ---
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@futsalbooking.id
BREVO_SENDER_NAME="Booking Lapangan"

# --- 5. FIREBASE CLOUD MESSAGING (Web Push Notification) ---
FIREBASE_PROJECT_ID=futsal-booking-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@futsal-booking.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- 6. AI CHATBOT ASSISTANT (Google Gemini) ---
SYSTEM_AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- 7. TIKTOK LOGIN KIT (OAuth Social Login) ---


